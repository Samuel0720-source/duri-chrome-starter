{
  "name": "duri-chrome-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "extension:build": "node scripts/build-extension.mjs",
    "extension:release": "node scripts/release-extension.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:db && npm run build && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:db": "node --test tests/database/*.test.mjs",
    "test:e2e": "playwright test",
    "test:flow": "playwright test -c playwright.flow.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "^8.16.0",
    "typescript": "~5.9.3"
  }
}
