{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.5.0",
  "description": "__MSG_description__",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_name__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/watch/*"
      ],
      "js": [
        "netflix-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/watch/*"
      ],
      "js": [
        "netflix-player.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "__DURI_ORIGIN__/room/watch*",
        "__DURI_ORIGIN__/room/draw*"
      ],
      "js": [
        "duri-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "default_locale": "en"
}
