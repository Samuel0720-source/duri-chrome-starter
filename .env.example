# P1 runs without credentials. P2+ get values from your own dev project.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; keep out of any NEXT_PUBLIC variable.
SUPABASE_SECRET_KEY=
AI_PROVIDER_API_KEY=
GOOGLE_PLACES_API_KEY=
PAID_API_ENABLED=false
# Proposed ceilings for phase 5, CAD. A zero budget disables paid upstream calls.
MONTHLY_EXTERNAL_API_BUDGET_CAD=0
ROOM_DAILY_AI_CALL_LIMIT=10
ROOM_DAILY_PLACES_CALL_LIMIT=3
